rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(teamId) {
      return signedIn() && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
    }
    function manager(teamId) {
      return member(teamId) &&
        get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role in ['owner','admin'];
    }
    match /teams/{teamId} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if member(teamId);
      allow update, delete: if false;
      match /members/{uid} {
        allow read: if member(teamId);
        allow create: if signedIn() && uid == request.auth.uid &&
          get(/databases/$(database)/documents/teams/$(teamId)).data.ownerUid == request.auth.uid;
        allow update, delete: if false;
      }
      match /people/{personId} {
        allow read: if member(teamId);
        allow create, update, delete: if manager(teamId);
      }
      match /ledger/{entryId} {
        allow read: if member(teamId);
        allow create: if manager(teamId) &&
          request.resource.data.actorUid == request.auth.uid &&
          request.resource.data.delta is int &&
          request.resource.data.delta != 0 &&
          request.resource.data.delta >= -99999 &&
          request.resource.data.delta <= 99999;
        allow update, delete: if false;
      }
    }
  }
}